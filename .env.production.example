##############################################################
# LYNERA - Profil .env PRODUKSI (Contoh)
# Salin file ini menjadi `.env`, lalu ubah value bertanda <ISI>
# Setelah itu jalankan:
#   php artisan key:generate
#   php artisan config:cache
#   php artisan route:cache
#   php artisan view:cache
#   php artisan storage:link
#   php artisan migrate --force
##############################################################

APP_NAME="LYNERA"
APP_TAGLINE="Smart Tools for Modern Makeup Artists"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<ISI-DOMAIN-ANDA>

# --- SUPER ADMIN SEED (WAJIB DIISI di produksi) ---
# Jalankan `php artisan db:seed --class=AdminUserSeeder --force` sekali setelah deploy.
# Kalau lupa password nanti, jalankan: php artisan lynera:reset-admin-password
SEED_ADMIN_EMAIL=<ISI-EMAIL-ADMIN>
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_PASSWORD=<ISI-PASSWORD-KUAT-MINIMAL-12-KARAKTER>

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- LOGGING ---
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- DATABASE (WAJIB) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<ISI-NAMA-DB>
DB_USERNAME=<ISI-USER-DB>
DB_PASSWORD=<ISI-PASSWORD-DB>

# --- SESSION / CACHE / QUEUE ---
# Untuk trafik tinggi disarankan pakai redis.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

# --- REDIS (opsional, aktifkan bila server mendukung) ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- MAIL (Resend direkomendasikan) ---
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="noreply@<ISI-DOMAIN-ANDA>"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=<ISI-RESEND-API-KEY>

# --- SaaS / Billing (Midtrans) ---
MIDTRANS_SERVER_KEY=<ISI-MIDTRANS-SERVER-KEY>
MIDTRANS_CLIENT_KEY=<ISI-MIDTRANS-CLIENT-KEY>
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_SNAP_URL=https://app.midtrans.com/snap/v2/vtweb
PAYMENT_DP_MIN_PERCENT=30

# --- Google Calendar (opsional) ---
GOOGLE_CLIENT_ID=<ISI-GOOGLE-CLIENT-ID>
GOOGLE_CLIENT_SECRET=<ISI-GOOGLE-CLIENT-SECRET>
GOOGLE_REDIRECT_URI=https://<ISI-DOMAIN-ANDA>/oauth/google/callback
GOOGLE_CALENDAR_ID=primary

# --- AWS S3 (opsional, bila mau menyimpan upload di S3) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

##############################################################
# CATATAN PRODUKSI
# 1. Pastikan `php artisan schedule:work` atau cron per menit
#    berjalan agar backup harian, reminder, dan auto-settle jalan.
# 2. Backup otomatis harian: `php artisan lynera:auto-backup --zip --notify`
# 3. Untuk mengaktifkan HTTPS-only cookie, pastikan APP_URL memakai https.
# 4. Nyalakan opcache PHP untuk performa maksimum.
##############################################################
